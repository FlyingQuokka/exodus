{
 "title": "UP Catch-up - Novice to Pro",
 "trigger": {
  "type": "tag_applied",
  "tags": [
   "Upgrade Done"
  ]
 },
 "run_multiple": true,
 "publish": true,
 "steps": [
  {
   "key": "C-check",
   "do": "condition",
   "note": "Only the member who made this jump continues.",
   "if": {
    "match": "all",
    "tags": [
     "Upgraded From Novice",
     "Pro Botter"
    ]
   },
   "yes": [],
   "no": [
