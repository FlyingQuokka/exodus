  },
  {
   "key": "C-wait-2",
   "do": "wait",
   "amount": 2,
   "unit": "days"
  },
  {
   "key": "C-UP03",
   "do": "email",
   "email": "UP03"
  },
  {
   "key": "C-wait-3",
   "do": "wait",
   "amount": 2,
   "unit": "days"
  },
  {
   "key": "C-UP06",
   "do": "email",
   "email": "UP06"
  },
  {
   "key": "C-wait-4",
   "do": "wait",
   "amount": 2,
   "unit": "days"
  },
  {
   "key": "C-UP08",
