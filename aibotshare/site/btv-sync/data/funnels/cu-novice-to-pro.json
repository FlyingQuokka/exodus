   "email": "UE02"
  },
  {
   "key": "C-wait-2",
   "do": "wait",
   "amount": 2,
   "unit": "days"
  },
  {
   "key": "C-UE03",
   "do": "email",
   "email": "UE03"
  },
  {
   "key": "C-wait-3",
   "do": "wait",
   "amount": 2,
   "unit": "days"
  },
  {
   "key": "C-UE05",
   "do": "email",
   "email": "UE05"
  },
  {
   "key": "C-wait-4",
   "do": "wait",
   "amount": 2,
   "unit": "days"
  },
  {
   "key": "C-UE06",
