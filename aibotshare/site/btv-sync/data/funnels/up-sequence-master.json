  {
   "key": "S-from-off",
   "do": "remove_tag",
   "tags": [
    "Upgraded From Pro"
   ],
   "note": "Not a jump, so no catch-up needs this tag."
  },
  {
   "key": "S-active-off",
   "do": "remove_tag",
   "tags": [
    "Upgrade Active"
   ]
  },
  {
   "key": "S-done-on",
   "do": "add_tag",
   "tags": [
    "Upgrade Done"
   ],
   "note": "Starts a catch-up if the member jumped."
  }
 ]
}
